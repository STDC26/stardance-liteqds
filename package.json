{
  "name": "stardance-liteqds",
  "version": "0.1.0",
  "private": true,
  "description": "LiteQDS canonical controlled rebuild (G1 recovery). Controlled rebuild — not recovered provenance.",
  "type": "module",
  "scripts": {
    "test:generator": "vitest run",
    "fixtures:generate": "tsx fixtures/generate-fixtures.ts",
    "evidence:manifest": "tsx harness/evidence/build-manifest.ts",
    "harness:dev": "vite --config vite.config.ts",
    "harness:build": "vite build --config vite.config.ts",
    "harness:preview": "vite preview --config vite.config.ts --port 4317 --strictPort",
    "test:harness": "playwright test",
    "xas:dev": "vite --config vite.xas.config.ts",
    "xas:build": "vite build --config vite.xas.config.ts",
    "xas:preview": "vite preview --config vite.xas.config.ts --port 4318 --strictPort",
    "test:xas": "playwright test --config playwright.xas.config.ts",
    "test:all": "npm run test:generator && npm run harness:build && npm run test:harness && npm run xas:build && npm run test:xas"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
